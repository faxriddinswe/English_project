APP_ENV=development
DATABASE_URL=postgresql+psycopg://sherzod:replace-db-password@127.0.0.1:5432/sherzod
POSTGRES_USER=sherzod
POSTGRES_PASSWORD=replace-db-password
POSTGRES_DB=sherzod
# Generate two independent random secrets: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-another-32-random-characters
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
# Exact direct reverse-proxy IPs only. Empty means ignore all forwarded identity headers.
TRUSTED_PROXY_IPS=
TIMEZONE=Asia/Tashkent
SESSION_HOURS=168
BILLING_DUE_DAY=10
ABSENCE_THRESHOLD=2
LOGIN_LIMIT=10
LEAD_LIMIT=6
MEDIA_ROOT=.local/media
STORAGE_BACKEND=disk
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional local integration tests; dedicated disposable database name must end with _test.
TEST_DATABASE_URL=
